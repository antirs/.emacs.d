+(defun org-babel-perl-evaluate-session
+    (session body &optional result-type result-params)
+  "Pass BODY to the re.pl process in SESSION.
+If RESULT-TYPE equals `output' then return standard output as a
+string.  If RESULT-TYPE equals `value' then return the value of
+the last statement in BODY, as elisp."
+  (let* ((body (concat org-babel-perl-preface body))
+         (tmp-file (org-babel-temp-file "perl-"))
+         (tmp-babel-file (org-babel-process-file-name
+                          tmp-file 'noquote))
+         (session (org-babel-perl-initiate-session session))
+         (prompt-regexp org-babel-perl-repl-prompt-regex))
+    (let ((results
+           (pcase result-type
+             (`output
+              (with-temp-file tmp-file
+                (mapconcat #'org-babel-perl-strip-repl-fancy-prompt
+                 (org-babel-comint-with-output
+                     (session org-babel-perl-eoe-output t body)
+                   (setq comint-prompt-regexp prompt-regexp)
+                   (insert (org-trim body)
+                           "\n" org-babel-perl-eoe-indicator)
+                   (comint-send-input nil t))
+                 "\n")
+                (buffer-string)))
+             (`value
+              (with-temp-buffer
+                (mapconcat #'org-babel-perl-strip-repl-fancy-prompt
+                 (org-babel-comint-in-buffer session
+                   (setq comint-prompt-regexp prompt-regexp)
+                   (goto-process-mark session)
+                   (insert (org-trim (format
+                                      org-babel-perl-session-wrapper-method
+                                      body tmp-babel-file))
+                           "\n" org-babel-perl-eoe-indicator)
+                   (comint-send-input nil t)
+                   (org-babel-comint-wait-for-output session))
+                 "\n")
+                (buffer-string))))))
+      (when results
+        (org-babel-result-cond result-params
+          (org-babel-eval-read-file tmp-file)
           (org-babel-import-elisp-from-file tmp-file '(16)))))))
 
+(defun org-babel-perl-strip-repl-fancy-prompt (string)
+  "Remove prompt cruft from a string of shell output."
+  ;; remove everything after EOE
+  (if (string-match "org_babel_perl_eoe" string)
+      (setq string (substring string 0 (match-beginning 0))))
+  (let ((match-readline
+         (rx-to-string
+          ;; " \\{79\\}\10  \15"
+          `(seq (= ,org-babel-perl-repl-readline-width ; readline width
+                   (literal " "))                      ; spaces
+                (literal"\10  \15"))))                 ; readline designator
+        (match-prompt
+         (rx-to-string
+          ;; "\\$+​\\|>+​"
+          `(|                           ; prompt alternatives
+            (seq (+ "$") "​")            ; prompt designator
+            (seq (+ ">") "​"))))         ; prompt continuation designator
+        (newstring))
+    (setq newstring
+          (with-output-to-string
+            (progn
+              ;; remove readline designators
+              (while (string-match match-readline string)
+                (progn (princ (substring string 0 (match-beginning 0)))
+                       (setq string (substring string (match-end 0)))))
+              (princ string))))
+    ;; remove fancy prompt designators
+    (while (string-match match-prompt newstring)
+      (insert (substring newstring 0 (match-beginning 0)))
+      (setq newstring (substring newstring (match-end 0))))
+    (insert newstring)))
+
