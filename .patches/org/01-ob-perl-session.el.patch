+(defun goto-process-mark (buffer-name)
+  "Move point in buffer and window to current process mark."
+  (save-current-buffer
+    (let* ((buffer (get-buffer-create buffer-name))
+           (buffer-window)
+           (buffer-process))
+      (setq buffer-window (get-buffer-window buffer t))
+      (setq buffer-process (get-buffer-process buffer))
+      (setq buffer-point (process-mark buffer-process))
+      (set-window-point buffer-window buffer-point)
+      (set-buffer buffer)
+      (goto-char buffer-point))))
