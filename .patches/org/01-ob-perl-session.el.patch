-(defun org-babel-perl-initiate-session (&optional _session _params)
-  "Return nil because sessions are not supported by perl."
-  nil)
+(defun org-babel-perl-initiate-session (&optional session _params)
+  "Initiate a session named SESSION according to PARAMS."
+  (unless (string= session "none")
+    (let ((found (catch 'found
+                   (dolist (p (process-list))
+                     (if (string= session
+                                  (buffer-name (process-buffer p)))
+                         (throw 'found t))))))
+      (if (not found)
+          ;; create new session
+          (save-current-buffer
+            (let ((initialization-code org-babel-perl-repl-code-replrc))
+              (setq comint-session
+                    (make-comint session
+                                 org-babel-perl-repl-program
+                                 org-babel-perl-repl-startfile
+                                 org-babel-perl-repl-switches))
+              (if (bufferp comint-session)
+                  (with-current-buffer (get-buffer-create comint-session)
+                    (rename-buffer session)))
+              (org-babel-comint-in-buffer session
+                (setq comint-use-prompt-regexp t)
+                (setq comint-prompt-regexp org-babel-perl-repl-prompt-regex)
+                (setq comint-eol-on-send t)
+                (setq comint-move-point-for-output t)
+                (insert initialization-code)
+                (comint-send-input nil t))
+              session))
+        ;; return existing session
+        session))))
 
