(use-package enomem/en :load-path "site-lisp" :defer t
  :init
  (defvar enomem-mode-map (make-keymap) "Key bindings for enomem-mode.")
  (define-minor-mode enomem-mode
    "enomem's minor mode" t " ~enomem" 'enomem-mode-map)
  (setq use-package-verbose 'debug)
  ;; enomem/en-keys
  (use-package enomem/en-keys :load-path "site-lisp")
  ;; enomem/en-loadpath
  (use-package enomem/en-loadpath :load-path "site-lisp")
  ;; enomem/en-scripts
